;; I really dont like how evil-cleverparens conflicts with `<' and `>'
;; for indenting, especially in visual mode
;; my versions allow slurping and barfing when on opening/closing sexp
;; but with region select or not on opening/closing, indent normally

(evil-define-command my/evil-cp-< (count)
  "Context-sensitive version of `evil-shift-left` and
Slurping/barfing operation that acts differently based on the
points location in the form.

- On opening paren: slurp backward.
- On closing paren: barf forward.
- If region is active, or point is not on delimiter: indent left.

Details:
Slurping/barfing operation that acts differently based on the
point's location in the form.
When point is on the opening delimiter of the form boundary, it
will slurp the next element backwards while maintaining the
location of the point in the original delimiter.

  foo [(]bar baz) -> [(]foo bar baz)

When point is on the closing delimiter, it will barf the
rightmost element of the form forward, again maintaining the
location of the point in the original delimiter. Only works if
the form has more than one element.

  (bar baz foo[)] -> (bar baz[)] foo

When point is in the middle of a form, it will act as like a
evil-shift-left-line.
Also works on regions. "
  (interactive "<c>")
  (setq count (or count 1))
  (cond
   ;; Respect region selection
   ((evil-visual-state-p)
    (evil-shift-left (region-beginning) (region-end)))
   ;; Slurp from opening delimiter
   ((evil-cp--looking-at-any-opening-p)
    (dotimes (_ count)
      (evil-cp--slurp-backward-from-opening)))
   ;; Barf from closing delimiter
   ((evil-cp--looking-at-any-closing-p)
    (dotimes (_ count)
      (unless (or (sp-point-in-empty-sexp)
                  (evil-cp--singleton-list-p))
        (let (sp-barf-move-point-with-delimiter)
          (sp-forward-barf-sexp))
        (sp-backward-sexp)
        (evil-cp-previous-closing))))
   ;; Fallback to indent if not on delimiter
   (t
    (evil-shift-left-line count))))

(evil-define-command my/evil-cp-> (count)
  "Context-sensitive version of `evil-shift-right` and
Slurping/barfing operation that acts differently based on the
points location in the form.

- On opening paren: barf backward.
- On closing paren: slurp forward.
- If region is active, or point is not on delimiter: indent right.

Details:
When cursor is on the opening delimiter of the form boundary, it
will barf the first element of the form while maintaining the
location of the cursor on the original delimiter.

  [(]foo bar baz) -> foo [(]bar baz)

When the cursor is on a closing delimiter, it will slurp the
first sexp after the last closing delimiter from point moving it
inside the form of which the cursor is currently on top of while
maintaining the location of the cursor on the current closing
delimiter.

  (((bar baz[)])) foo -> (((bar baz foo[)]))

When point is in the middle of a form, it will act as like a
evil-shift-right-line.
Also works on regions.
"
  (interactive "<c>")
  (setq count (or count 1))
  (cond
   ;; Respect region selection
   ((evil-visual-state-p)
    (evil-shift-right (region-beginning) (region-end)))
   ;; Barf backward from opening delimiter
   ((evil-cp--looking-at-any-opening-p)
    (dotimes (_ count)
      (unless (or (sp-point-in-empty-sexp)
                  (evil-cp--singleton-list-p))
        (let (sp-barf-move-point-with-delimiter)
          (sp-backward-barf-sexp))
        (sp-forward-sexp)
        (evil-cp-next-opening))))
   ;; Slurp forward from closing delimiter
   ((evil-cp--looking-at-any-closing-p)
    (dotimes (_ count)
      (evil-cp--slurp-forward-from-closing)))
   ;; Fallback to indent if not on delimiter
   (t
    (evil-shift-right-line count))))

(use-package evil-cleverparens
  :after evil
  :after map
  ;; :defer t
  ;; TODO: still doesnt set properly, idk why
  :hook ((emacs-lisp-mode clojure-mode) . smartparens-strict-mode)
  :config
  ;; got `map-put!' not found error
  ;; I added `:after map' to fix it (i think?)
  (map-put! evil-cp-regular-bindings "<" #'my/evil-cp-<)
  (map-put! evil-cp-regular-bindings ">" #'my/evil-cp->)
  (map!
   :mode evil-cleverparens-mode
   :n "<" #'my/evil-cp-<
   :v "<" #'my/evil-cp-<
   :n ">" #'my/evil-cp->
   :v ">" #'my/evil-cp->))

(use-package! smartparens
  :hook (((emacs-lisp-mode lisp-mode clojure-mode) . smartparens-strict-mode)
         ((emacs-lisp-mode lisp-mode clojure-mode) . evil-smartparens-mode)))
