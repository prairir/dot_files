(defun my/org-toggle-checkbox-presence ()
  "Toggle checkbox presence for any org list item.
Works on all list types and supports region operations."
  (interactive)
  (if (use-region-p)
      ;; Process region
      (let ((beg (region-beginning))
            (end (region-end))
            (modified-marker (make-marker)))
        (set-marker modified-marker end)
        (save-excursion
          (goto-char beg)
          (while (< (point) (marker-position modified-marker))
            (when (org-at-item-p)
              (my/org-toggle-checkbox-presence-at-point)
              ;; Update marker if line length changed
              (set-marker modified-marker
                          (+ (marker-position modified-marker)
                             (- (pos-eol) (pos-bol) (current-indentation))
                             (if (= (line-number-at-pos) (line-number-at-pos (marker-position modified-marker)))
                                 (- (current-indentation))
                               0))))
            (forward-line 1)
            (when (eobp) (goto-char (marker-position modified-marker)))))
        (set-marker modified-marker nil))
    ;; Process single item
    (when (org-at-item-p)
      (my/org-toggle-checkbox-presence-at-point))))

(defun my/org-toggle-checkbox-presence-at-point ()
  "Add or remove checkbox at the current list item."
  (save-excursion
    (beginning-of-line)
    (let ((bound (save-excursion (end-of-line) (point))))
      (when (re-search-forward org-list-full-item-re bound t)
        (goto-char (match-end 1))
        (if (looking-at "\\[[ X-]\\][ \t]+")
            ;; Remove checkbox
            (delete-region (match-beginning 0) (match-end 0))
          ;; Add checkbox
          (insert "[ ] "))))))

(map!
 :after org
 :map org-mode-map
 :leader
 :desc "toggle checkbox presence"
 "m X" #'my/org-toggle-checkbox-presence)


