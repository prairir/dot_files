(defun my/yank-current-file-name ()
  "Yank the file name of the current buffer."
  (interactive)
  (if buffer-file-name
      (let ((file-name (file-name-nondirectory buffer-file-name)))
        (kill-new file-name)
        (message "Yanked file name: %s" file-name))
    (message "Buffer is not visiting a file")))

(defun my/yank-current-file-name-no-extension ()
  "Yank the file name of the current buffer without the extension."
  (interactive)
  (if buffer-file-name
      (let ((file-name (file-name-sans-extension (file-name-nondirectory buffer-file-name))))
        (kill-new file-name)
        (message "Yanked file name without extension: %s" file-name))
    (message "Buffer is not visiting a file")))

(map! :leader
      :prefix "f"
      :desc "Yank file name"
      "n" #'my/yank-current-file-name
      :desc "Yank file name without extension"
      "N" #'my/yank-current-file-name-no-extension)


(defun my/switch-or-create-vterm ()
  "Switch to an existing vterm buffer in current workspace, or create a new one. Will use popup buffer if exists"
  (interactive)
  (let ((existing-vterm
         (cl-find-if (lambda (buf)
                       (and (string-match-p "\\(vterm-popup\\|^\\*vterm\\)" (buffer-name buf))
                            (persp-contain-buffer-p buf)))
                     (buffer-list))))
    (if existing-vterm
        (switch-to-buffer existing-vterm)
      (+vterm/here nil))))

(map! :leader
      :prefix "o"
      :desc "Open/Switch vterm here"
      "T" #'my/switch-or-create-vterm)

